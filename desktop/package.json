{
  "name": "elvora-desktop",
  "version": "1.0.0",
  "description": "Elvora - Restoran Yönetim Sistemi Masaüstü Uygulaması",
  "main": "main.js",
  "author": "Elvora",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elvora.desktop",
    "productName": "Elvora",
    "copyright": "Copyright © 2026 Elvora",
    "files": [
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "publisherName": "Elvora",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Elvora",
      "artifactName": "Elvora-Kurulum-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "artifactName": "Elvora-${version}.${ext}"
    }
  }
}
